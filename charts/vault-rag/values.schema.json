{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "imagePullSecrets", "service", "storage", "embeddingModel", "serviceConfig", "monitoring", "networkPolicy", "podAnnotations", "nodeSelector", "tolerations", "affinity"],
  "properties": {
    "image": {"$ref": "#/definitions/image"},
    "imagePullSecrets": {"type": "array", "items": {"$ref": "#/definitions/imagePullSecret"}},
    "service": {"$ref": "#/definitions/service"},
    "storage": {"$ref": "#/definitions/storage"},
    "api": {"anyOf": [{"$ref": "#/definitions/api"}, {"type": "null"}]},
    "worker": {"anyOf": [{"$ref": "#/definitions/worker"}, {"type": "null"}]},
    "migrations": {"anyOf": [{"$ref": "#/definitions/migrations"}, {"type": "null"}]},
    "sqlite": {"anyOf": [{"$ref": "#/definitions/sqlite"}, {"type": "null"}]},
    "embeddingModel": {"type": "string", "minLength": 1},
    "serviceConfig": {"$ref": "#/definitions/serviceConfig"},
    "monitoring": {"$ref": "#/definitions/monitoring"},
    "networkPolicy": {"$ref": "#/definitions/networkPolicy"},
    "podAnnotations": {"$ref": "#/definitions/stringMap"},
    "nodeSelector": {"$ref": "#/definitions/stringMap"},
    "tolerations": {"type": "array", "items": {"$ref": "#/definitions/toleration"}},
    "affinity": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"storage": {"properties": {"backend": {"const": "sqlite"}}}}},
      "then": {
        "required": ["sqlite"],
        "properties": {
          "api": {"type": "null"},
          "worker": {"type": "null"},
          "migrations": {"type": "null"},
          "sqlite": {"$ref": "#/definitions/sqlite"}
        }
      }
    },
    {
      "if": {"properties": {"storage": {"properties": {"backend": {"const": "postgresql"}}}}},
      "then": {
        "required": ["api", "worker", "migrations"],
        "properties": {
          "api": {"$ref": "#/definitions/api"},
          "worker": {"$ref": "#/definitions/worker"},
          "migrations": {"$ref": "#/definitions/migrations"},
          "sqlite": {"type": "null"}
        }
      }
    }
  ],
  "definitions": {
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      },
      "anyOf": [
        {"properties": {"tag": {"minLength": 1}}},
        {"properties": {"digest": {"pattern": "^sha256:[a-f0-9]{64}$"}}}
      ]
    },
    "imagePullSecret": {
      "type": "object", "additionalProperties": false,
      "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}
    },
    "service": {
      "type": "object", "additionalProperties": false,
      "required": ["annotations"], "properties": {"annotations": {"$ref": "#/definitions/stringMap"}}
    },
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "secretReference": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {"name": {"type": "string", "minLength": 1}, "key": {"type": "string", "minLength": 1}}
    },
    "apiRuntimeSecret": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "litellmKey"],
      "properties": {"name": {"type": "string", "minLength": 1}, "litellmKey": {"type": "string", "minLength": 1}}
    },
    "workerRuntimeSecret": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "githubToken", "litellmKey"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "githubToken": {"type": "string", "minLength": 1},
        "litellmKey": {"type": "string", "minLength": 1}
      }
    },
    "sqliteSecrets": {
      "type": "object", "additionalProperties": false,
      "required": ["githubToken", "litellmApiKey"],
      "properties": {"githubToken": {"$ref": "#/definitions/secretReference"}, "litellmApiKey": {"$ref": "#/definitions/secretReference"}}
    },
    "quantity": {"type": "string", "minLength": 1},
    "resourceList": {
      "type": "object", "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {"cpu": {"$ref": "#/definitions/quantity"}, "memory": {"$ref": "#/definitions/quantity"}}
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {"requests": {"$ref": "#/definitions/resourceList"}, "limits": {"$ref": "#/definitions/resourceList"}}
    },
    "duration300s": {"type": "string", "pattern": "^(([1-9]|[1-9][0-9]|[12][0-9]{2}|300)s|[1-5]m)$"},
    "duration24h": {"type": "string", "pattern": "^(([1-9][0-9]{0,3}|[1-7][0-9]{4}|8[0-5][0-9]{3}|86[0-3][0-9]{2}|86400)s|([1-9][0-9]{0,2}|1[0-3][0-9]{2}|14[0-3][0-9]|1440)m|([1-9]|1[0-9]|2[0-4])h)$"},
    "duration365d": {
      "anyOf": [
        {"type": "string", "pattern": "^([1-9]|[1-9][0-9]{1,6}|[12][0-9]{7}|30[0-9]{6}|31[0-4][0-9]{5}|315[0-2][0-9]{4}|3153[0-5][0-9]{3}|31536000)s$"},
        {"type": "string", "pattern": "^([1-9]|[1-9][0-9]{1,4}|[1-4][0-9]{5}|5[01][0-9]{4}|52[0-4][0-9]{3}|525[0-5][0-9]{2}|525600)m$"},
        {"type": "string", "pattern": "^([1-9]|[1-9][0-9]{1,2}|[1-7][0-9]{3}|8[0-6][0-9]{2}|87[0-5][0-9]|8760)h$"},
        {"type": "string", "pattern": "^([1-9]|[1-9][0-9]|[12][0-9]{2}|3[0-5][0-9]|36[0-5])d$"}
      ]
    },
    "cleanup": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "keepPromoted", "minAge", "batchSize"],
      "properties": {
        "enabled": {"type": "boolean"},
        "keepPromoted": {"type": "integer", "minimum": 0, "maximum": 1000},
        "minAge": {"$ref": "#/definitions/duration365d"},
        "batchSize": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "storagePool": {
      "type": "object", "additionalProperties": false,
      "required": ["minSize", "maxSize", "timeout"],
      "properties": {
        "minSize": {"type": "integer", "minimum": 1, "maximum": 20},
        "maxSize": {"type": "integer", "minimum": 1, "maximum": 50},
        "timeout": {"$ref": "#/definitions/duration300s"}
      }
    },
    "storage": {
      "type": "object", "additionalProperties": false,
      "required": ["backend"],
      "properties": {
        "backend": {"enum": ["", "sqlite", "postgresql"]},
        "className": {"type": ["string", "null"]},
        "size": {"type": ["string", "null"]},
        "replicas": {"type": ["integer", "null"]},
        "databaseUrlEnv": {"type": ["string", "null"]},
        "ownerRole": {"type": ["string", "null"], "pattern": "^[a-z_][a-z0-9_]{0,62}$"},
        "pool": {"anyOf": [{"$ref": "#/definitions/storagePool"}, {"type": "null"}]},
        "connectTimeout": {"anyOf": [{"$ref": "#/definitions/duration300s"}, {"type": "null"}]},
        "statementTimeout": {"anyOf": [{"$ref": "#/definitions/duration300s"}, {"type": "null"}]},
        "lockTimeout": {"anyOf": [{"$ref": "#/definitions/duration300s"}, {"type": "null"}]},
        "idleTransactionTimeout": {"anyOf": [{"$ref": "#/definitions/duration300s"}, {"type": "null"}]},
        "allowInsecureTransport": {"type": ["boolean", "null"]},
        "cleanup": {"anyOf": [{"$ref": "#/definitions/cleanup"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"backend": {"const": "sqlite"}}},
          "then": {"required": ["className", "size", "replicas"], "properties": {
            "className": {"type": "string"}, "size": {"$ref": "#/definitions/quantity"}, "replicas": {"const": 1},
            "databaseUrlEnv": {"type": "null"}, "ownerRole": {"type": "null"}, "pool": {"type": "null"},
            "connectTimeout": {"type": "null"}, "statementTimeout": {"type": "null"}, "lockTimeout": {"type": "null"}, "idleTransactionTimeout": {"type": "null"},
            "allowInsecureTransport": {"type": "null"}, "cleanup": {"type": "null"}
          }}
        },
        {
          "if": {"properties": {"backend": {"const": "postgresql"}}},
          "then": {"required": ["databaseUrlEnv", "pool", "connectTimeout", "statementTimeout", "lockTimeout", "idleTransactionTimeout", "allowInsecureTransport", "cleanup"], "properties": {
            "className": {"type": "null"}, "size": {"type": "null"}, "replicas": {"type": "null"},
            "databaseUrlEnv": {"const": "VAULT_RAG_DATABASE_URL"}, "pool": {"$ref": "#/definitions/storagePool"},
            "connectTimeout": {"$ref": "#/definitions/duration300s"}, "statementTimeout": {"$ref": "#/definitions/duration300s"},
            "lockTimeout": {"$ref": "#/definitions/duration300s"}, "idleTransactionTimeout": {"$ref": "#/definitions/duration300s"},
            "allowInsecureTransport": {"type": "boolean"}, "cleanup": {"$ref": "#/definitions/cleanup"}
          }}
        }
      ]
    },
    "pdb": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "minAvailable"],
      "properties": {"enabled": {"type": "boolean"}, "minAvailable": {"type": "integer", "minimum": 1}}
    },
    "api": {
      "type": "object", "additionalProperties": false,
      "required": ["replicas", "databaseSecret", "runtimeSecret", "resources", "autoscaling", "topologySpread", "pdb"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 2, "maximum": 20},
        "databaseSecret": {"$ref": "#/definitions/secretReference"}, "runtimeSecret": {"$ref": "#/definitions/apiRuntimeSecret"}, "resources": {"$ref": "#/definitions/resources"},
        "autoscaling": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage"],
          "properties": {
            "enabled": {"type": "boolean"}, "minReplicas": {"type": "integer", "minimum": 2, "maximum": 20},
            "maxReplicas": {"type": "integer", "minimum": 2, "maximum": 50}, "targetCPUUtilizationPercentage": {"type": "integer", "minimum": 1, "maximum": 100}
          }
        },
        "topologySpread": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "maxSkew", "topologyKey", "whenUnsatisfiable"],
          "properties": {"enabled": {"type": "boolean"}, "maxSkew": {"type": "integer", "minimum": 1, "maximum": 10}, "topologyKey": {"type": "string", "minLength": 1}, "whenUnsatisfiable": {"enum": ["DoNotSchedule", "ScheduleAnyway"]}}
        },
        "pdb": {"$ref": "#/definitions/pdb"}
      }
    },
    "worker": {
      "type": "object", "additionalProperties": false,
      "required": ["replicas", "terminationGracePeriodSeconds", "databaseSecret", "runtimeSecret", "checkout", "resources", "pdb"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 1, "maximum": 20}, "terminationGracePeriodSeconds": {"type": "integer", "minimum": 30, "maximum": 3600},
        "databaseSecret": {"$ref": "#/definitions/secretReference"}, "runtimeSecret": {"$ref": "#/definitions/workerRuntimeSecret"},
        "checkout": {"type": "object", "additionalProperties": false, "required": ["sizeLimit"], "properties": {"sizeLimit": {"$ref": "#/definitions/quantity"}}},
        "resources": {"$ref": "#/definitions/resources"}, "pdb": {"$ref": "#/definitions/pdb"}
      }
    },
    "migrations": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "databaseSecret", "backoffLimit", "activeDeadlineSeconds", "ttlSecondsAfterFinished"],
      "properties": {"enabled": {"type": "boolean"}, "databaseSecret": {"$ref": "#/definitions/secretReference"}, "backoffLimit": {"type": "integer", "minimum": 0, "maximum": 10}, "activeDeadlineSeconds": {"type": "integer", "minimum": 1, "maximum": 3600}, "ttlSecondsAfterFinished": {"type": "integer", "minimum": 0, "maximum": 604800}}
    },
    "sqlite": {
      "type": "object", "additionalProperties": false,
      "required": ["resources", "secrets"],
      "properties": {"resources": {"$ref": "#/definitions/resources"}, "secrets": {"$ref": "#/definitions/sqliteSecrets"}}
    },
    "serviceConfig": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "syncInterval", "repositories", "profiles", "embedding"],
      "properties": {"schemaVersion": {"const": 2}, "syncInterval": {"$ref": "#/definitions/duration24h"}, "mcp": {"$ref": "#/definitions/mcpTransport"}, "repositories": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/definitions/repository"}}, "profiles": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/definitions/profile"}}, "embedding": {"$ref": "#/definitions/embedding"}}
    },
    "mcpTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "allowedHosts", "allowedOrigins"],
      "properties": {
        "enabled": {"type": "boolean"},
        "allowedHosts": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "allowedOrigins": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
      },
      "allOf": [
        {"if": {"properties": {"enabled": {"const": true}}}, "then": {"properties": {"allowedHosts": {"minItems": 1}}}},
        {"if": {"properties": {"enabled": {"const": false}}}, "then": {"properties": {"allowedHosts": {"maxItems": 0}, "allowedOrigins": {"maxItems": 0}}}}
      ]
    },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "ref"],
      "properties": {"url": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/.*)?$"}, "ref": {"type": "string", "pattern": "^refs/(heads|tags)/"}, "credentialEnv": {"const": "GITHUB_TOKEN"}}
    },
    "profile": {"type": "object", "additionalProperties": false, "required": ["vaults"], "properties": {"vaults": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "embedding": {
      "type": "object", "additionalProperties": false,
      "required": ["baseUrl", "modelEnv", "endpointClass"],
      "properties": {
        "baseUrl": {"type": "string", "pattern": "^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/.*)?$"}, "apiKeyEnv": {"const": "LITELLM_API_KEY"}, "modelEnv": {"const": "VAULT_RAG_EMBEDDING_MODEL"}, "endpointClass": {"enum": ["local", "remote"]}, "batchSize": {"type": "integer", "minimum": 1, "maximum": 256}, "maxBatchTokens": {"type": "integer", "minimum": 1, "maximum": 300000}, "tokenizer": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}, "dimensions": {"type": ["integer", "null"], "minimum": 1}, "targetMinTokens": {"type": "integer", "minimum": 1}, "targetMaxTokens": {"type": "integer", "minimum": 1}, "overlapTokens": {"type": "integer", "minimum": 0}, "maxInputTokens": {"type": "integer", "minimum": 1}
      }
    },
    "monitoring": {"type": "object", "additionalProperties": false, "required": ["serviceMonitor", "podMonitor"], "properties": {"serviceMonitor": {"type": "boolean"}, "podMonitor": {"type": "boolean"}}},
    "networkPolicy": {"type": "object", "additionalProperties": false, "required": ["enabled", "ingress", "egress"], "properties": {"enabled": {"type": "boolean"}, "ingress": {"$ref": "#/definitions/ingressPolicy"}, "egress": {"$ref": "#/definitions/egressPolicy"}}},
    "cidrs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "ports": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1, "maximum": 65535}},
    "labelSelectorRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "operator"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "operator": {"enum": ["In", "NotIn", "Exists", "DoesNotExist"]},
        "values": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"operator": {"enum": ["In", "NotIn"]}}},
          "then": {"required": ["values"]}
        },
        {
          "if": {"properties": {"operator": {"enum": ["Exists", "DoesNotExist"]}}},
          "then": {"properties": {"values": {"maxItems": 0}}}
        }
      ]
    },
    "namespaceSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": {"$ref": "#/definitions/stringMap"},
        "matchExpressions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/labelSelectorRequirement"}
        }
      },
      "anyOf": [{"required": ["matchLabels"]}, {"required": ["matchExpressions"]}]
    },
    "ingressPolicy": {"type": "object", "additionalProperties": false, "required": ["cidrs", "ports", "namespaceSelector"], "properties": {"cidrs": {"$ref": "#/definitions/cidrs"}, "ports": {"$ref": "#/definitions/ports"}, "namespaceSelector": {"$ref": "#/definitions/namespaceSelector"}}},
    "egressPolicy": {"type": "object", "additionalProperties": false, "required": ["databaseCidrs", "databasePorts", "httpsCidrs", "httpsPorts", "dnsNamespaceSelector", "dnsPorts"], "properties": {"databaseCidrs": {"$ref": "#/definitions/cidrs"}, "databasePorts": {"$ref": "#/definitions/ports"}, "httpsCidrs": {"$ref": "#/definitions/cidrs"}, "httpsPorts": {"$ref": "#/definitions/ports"}, "dnsNamespaceSelector": {"$ref": "#/definitions/namespaceSelector"}, "dnsPorts": {"$ref": "#/definitions/ports"}}},
    "toleration": {"type": "object", "additionalProperties": false, "properties": {"key": {"type": "string"}, "operator": {"enum": ["Exists", "Equal"]}, "value": {"type": "string"}, "effect": {"enum": ["NoSchedule", "PreferNoSchedule", "NoExecute"]}, "tolerationSeconds": {"type": "integer", "minimum": 0}}}
  }
}
